{
  "name": "mas-nakit-radar",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "bash scripts/db/ensure.sh && next dev",
    "build": "next build --turbopack",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "spike": "tsx scripts/parse-spike.ts",
    "db:verify": "bash scripts/db/ensure.sh && bash scripts/db/verify.sh",
    "db:types": "tsx scripts/db/gen-types.ts",
    "db:dev:reset": "bash scripts/db/dev-reset.sh",
    "db:migrate": "tsx scripts/db/migrate.ts",
    "db:migrate:dev": "tsx scripts/db/ensure.ts && tsx scripts/db/migrate.ts",
    "db:migrate:verify": "tsx scripts/db/ensure.ts && tsx scripts/db/migrate-verify.ts",
    "db:constraints:verify": "tsx scripts/db/constraints-verify.ts",
    "db:transitions:verify": "tsx scripts/db/transitions-verify.ts",
    "db:reconciliation:verify": "tsx scripts/db/reconciliation-verify.ts",
    "db:legacy-repair:verify": "tsx scripts/db/legacy-repair-verify.ts",
    "import:real": "bash scripts/db/ensure.sh && tsx scripts/import-real.ts",
    "phase3:verify": "bash scripts/db/ensure.sh && tsx scripts/phase3-verify.ts",
    "phase4:verify": "bash scripts/db/ensure.sh && tsx scripts/phase4-verify.ts",
    "phase5:verify": "bash scripts/db/ensure.sh && tsx scripts/phase5-verify.ts",
    "phase6:verify": "bash scripts/db/ensure.sh && tsx scripts/phase6-verify.ts",
    "phase6b:verify": "bash scripts/db/ensure.sh && tsx scripts/phase6b-verify.ts",
    "phase7:verify": "bash scripts/db/ensure.sh && tsx scripts/phase7-verify.ts",
    "phase8:verify": "bash scripts/db/ensure.sh && tsx scripts/phase8-verify.ts",
    "phase9a:verify": "bash scripts/db/ensure.sh && tsx scripts/phase9a-verify.ts",
    "phase9b:verify": "bash scripts/db/ensure.sh && tsx scripts/phase9b-verify.ts",
    "phase9c:verify": "bash scripts/db/ensure.sh && tsx scripts/phase9c-verify.ts",
    "phase9d:verify": "bash scripts/db/ensure.sh && tsx scripts/phase9d-verify.ts",
    "phase11b:verify": "node --import tsx scripts/phase11b-verify.ts",
    "phase12a:verify": "node --import tsx scripts/phase12a-verify.ts",
    "phase13a:verify": "node --import tsx scripts/phase13a-verify.ts",
    "phase13b:verify": "node --import tsx scripts/phase13b-verify.ts",
    "phase14a:verify": "node --import tsx scripts/phase14a-verify.ts",
    "phase14b:verify": "node --import tsx scripts/phase14b-verify.ts",
    "phase14c:verify": "node --import tsx scripts/phase14c-verify.ts",
    "phase14d:verify": "node --import tsx scripts/phase14d-verify.ts",
    "phase14e:verify": "node --import tsx scripts/phase14e-verify.ts",
    "seed:demo": "bash scripts/db/ensure.sh && tsx scripts/seed-demo.ts",
    "test:visual": "playwright test",
    "test:visual:update": "playwright test --update-snapshots"
  },
  "dependencies": {
    "date-fns": "^4.4.0",
    "exceljs": "^4.4.0",
    "next": "15.5.20",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "xlsx": "^0.18.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.3",
    "eslint": "^9",
    "eslint-config-next": "15.5.20",
    "jsdom": "^29.1.1",
    "pg": "^8.22.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.0",
    "typescript": "^5",
    "vitest": "^4.1.9"
  }
}
