# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (secrets stay local); the template is committed
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local source data (private financials) — root-anchored (/data/) so it ignores ONLY the
# top-level data/ workbook directory. A bare `data/` matches every nested data/ dir at any
# depth, which silently swallowed src/components/data/ (reconciliation-table.tsx never got
# committed → CI typecheck TS2307) and would have swallowed src/app/(dashboard)/data/ too had
# it not already been tracked. Anchor any future ignore of a data/ path explicitly.
/data/

# database backups (private financial dumps — never commit)
/backups/
*.dump
*.sql.gz

# playwright artifacts (baselines under tests/visual/__snapshots__ ARE committed)
/test-results/
/playwright-report/
/blob-report/

# generated recovery/build artifacts
/.next-corrupt-*/
/.next-turbopack-incomplete-*/
# release:real-clone-gate ayri distDir'e derler — canli sunucunun .next'ini ezmemek icin
/.next-real-clone-gate/
/.next-stage10-perf/
/.next-restore-drill/
# ASAMA 11 / B6: eski bir commit'in agaci (git archive) code/schema pairing provasi icin
# buraya cikarilir; kalici degildir ve depoya girmez.
/.stage11-oldcode/

# local pnpm content-addressable store
/.pnpm-store/

# stray local artifacts — never commit
/debug.log
/cloudflared-windows-amd64.msi
__pycache__/

# Playwright storageState — REAL session cookies minted by tests/visual/global-setup.ts.
# These are live credentials for whatever database the harness last ran against; committing them
# would publish a working session token and would also go stale the moment that disposable
# database is dropped. Regenerated from scratch on every run.
/tests/visual/.auth/

# AŞAMA 09 — operasyonel telemetri günlükleri (alert log + koşu kayıtları + zamanlanmış görev
# çıktısı). backups/ ile aynı gerekçe: bunlar OPERASYONEL veridir — hangi hesabın kilitlendiği,
# hangi içe aktarımın bayatladığı, hangi veritabanının ne kadar büyüdüğü. Depoya ait değil ve
# her koşuda değiştiği için ağacı da kirletir. Dizinin kendisi ilk koşuda oluşturulur.
/logs/
/.next-interaction-gate/
/test-results/
/.next-speed-verify/
