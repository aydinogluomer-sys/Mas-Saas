# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (secrets stay local); the template is committed
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local source data (private financials)
data/
# The application route `/data` is source code, not private workbook data.
!src/app/(dashboard)/data/
!src/app/(dashboard)/data/**

# database backups (private financial dumps — never commit)
/backups/
*.dump
*.sql.gz

# playwright artifacts (baselines under tests/visual/__snapshots__ ARE committed)
/test-results/
/playwright-report/
/blob-report/

# generated recovery/build artifacts
/.next-corrupt-*/
/.next-turbopack-incomplete-*/

# local pnpm content-addressable store
/.pnpm-store/

# stray local artifacts — never commit
/debug.log
/cloudflared-windows-amd64.msi
__pycache__/
