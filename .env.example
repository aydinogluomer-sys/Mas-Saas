# MAS Nakit Radar — environment template. Copy to .env.local and fill in.
# NEVER commit .env.local. Real secrets stay out of git (.gitignore blocks .env*).

# ── Database (required) ──────────────────────────────────────────────
# Two roles since Faz 15, deliberately NOT the same connection string.
#
# DATABASE_URL is what the Next.js runtime connects as: the low-privilege
# `mas_radar_app` role (NOSUPERUSER, NOBYPASSRLS), created by migration 0035. This
# is the one that makes the RLS policies real — a superuser bypasses them all.
# There is no built-in fallback any more: if this is unset the app refuses to start
# rather than quietly reconnecting as the owner.
DATABASE_URL=postgres://mas_radar_app:CHANGE_ME@127.0.0.1:5432/mas_radar_dev
# MIGRATION_DATABASE_URL is the owner/superuser connection, used ONLY by scripts that
# create or alter schema, roles and seed accounts (migrate, seed-admin,
# seed-system-actor, legacy-repair*, backup-receipt). Never read by the app itself.
# If unset it falls back to DATABASE_URL, which keeps older setups working — but on a
# split cluster that fallback would fail, so keep both filled in.
MIGRATION_DATABASE_URL=postgres://postgres:CHANGE_ME@127.0.0.1:5432/mas_radar_dev
# Password for the mas_radar_app role. Read ONLY by
# `pnpm db:app-role:password` (scripts/db/set-app-role-password.ts), which sets it on
# the role and flips it to LOGIN; never logged, never accepted as a CLI argument.
# Run that script once per cluster, then put the same value into DATABASE_URL above.
MAS_RADAR_APP_DB_PASSWORD=CHANGE_ME

# ── Native PostgreSQL 16 (ops; the only canonical database) ──────────
# The cluster lives in C:\MAS\pgdata16 and runs as the Windows service MAS-PostgreSQL16,
# listening on 127.0.0.1/::1:5432 only (docs/ops/postgres-service.md). Docker is not used
# on this machine any more; docker-compose.yml was removed.
#  - Write the literal 127.0.0.1 in the two URLs above: Node may resolve "localhost" to ::1
#    first. Scripts refuse any host that is not this machine.
#  - The owner (postgres) password is a real, strong secret: never the well-known docker
#    dev default, never on a command line. The backup tools receive it only through their
#    own process environment (PGPASSWORD), never as an argument.
# MAS_PG_RUNTIME picks the toolchain the backup/restore/migrate scripts use:
#   native (default) = PostgreSQL 16 tools from MAS_PG_BIN_DIR against the local service;
#   docker           = the throwaway CI container only (.github/workflows/ci.yml sets it).
MAS_PG_RUNTIME=native
# Absolute path of the PostgreSQL 16 bin directory (pg_dump, pg_restore, psql, createdb,
# dropdb, pg_isready). Empty = look the tools up on PATH. Not a secret.
MAS_PG_BIN_DIR=C:\MAS\pgsql16\bin
# Optional upper bound for one pg_dump run, in milliseconds (default 1800000 = 30 min).
MAS_BACKUP_TIMEOUT_MS=
# Extra alert channel for the telemetry watch task (logs/alerts.jsonl is always written).
# telegram = the owner's chat (TELEGRAM_BOT_TOKEN + TELEGRAM_CHAT_ID below); nothing else
# leaves the machine.
MAS_ALERT_CHANNELS=

# ── Auth (P0-A) — real multi-user login, always required ─────────────
# No env var disables login entirely — every dashboard route and /api/facts always
# requires a signed-in account. The first admin account is created once via:
#   tsx scripts/db/seed-admin.ts --username admin --display-name "Admin"
# SEED_ADMIN_PASSWORD, if set, supplies that script's password non-interactively
# (never logged); otherwise it prompts with a masked input. Not read anywhere else.
SEED_ADMIN_PASSWORD=CHANGE_ME
# TestSprite QA harness only — narrowly scoped bypass (requires NODE_ENV!=="production"
# too) that only works against a disposable DB seeded with the reserved "testsprite-qa"
# account (scripts/db/create-testsprite-db.ts). Never set this against a real database.
MAS_QA_BYPASS_AUTH=

# ── Telegram reminders (optional; SERVER-ONLY) ───────────────────────
# If unset, reminder dispatch logs 'failed' honestly (no send). Never exposed to client.
TELEGRAM_BOT_TOKEN=
# The owner's chat: the only chat reminders are sent to AND the only chat the read-only
# Telegram assistant (bot.py + /api/telegram/assistant) answers. Unset = it answers nobody.
TELEGRAM_CHAT_ID=
# Shared secret between bot.py and /api/telegram/assistant, both on this machine. At least
# 32 characters (the app refuses to boot with a shorter one); unset = the assistant is closed.
# Generate a long random value for .env.local; never commit it, never give it to Telegram.
TELEGRAM_INTERNAL_API_KEY=
# Loopback URL of the running MAS SaaS server, used by bot.py. bot.py refuses to start with
# any host other than 127.0.0.1 / localhost / ::1, so the key never leaves this machine.
# Match the actual Next.js port; use 3001 here instead if `pnpm dev` reports :3001.
MAS_APP_BASE_URL=http://127.0.0.1:3000

# ── AI Q&A / report commentary (optional; SERVER-ONLY) ───────────────
# If OPENAI_API_KEY is unset, /ask falls back to deterministic facts-only answers.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5
AI_FORCE_DETERMINISTIC=0

# ── Build/version metadata (optional) ────────────────────────────────
# Shown on /version. Populate from git in CI/deploy if desired.
APP_COMMIT_SHA=
APP_BUILD_TIME=
