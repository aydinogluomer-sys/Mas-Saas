# MAS Nakit Radar — environment template. Copy to .env.local and fill in.
# NEVER commit .env.local or plaintext .env.local.bak* backups (.gitignore blocks .env* and .env*.bak*).
# NOTE: Every <REPLACE_WITH_STRONG_SECRET> / CHANGE_ME placeholder below MUST be replaced in .env.local;
# `tsx scripts/check-env.ts` actively rejects placeholder passwords and non-mas_radar_app runtime roles.

# ── Database (required) ──────────────────────────────────────────────
# DATABASE_URL MUST connect as the low-privilege `mas_radar_app` role (NOSUPERUSER, NOBYPASSRLS).
DATABASE_URL=postgres://mas_radar_app:CHANGE_ME@127.0.0.1:5432/mas_radar_dev
# MIGRATION_DATABASE_URL is the owner/superuser connection used ONLY by migration/seed/backup scripts.
MIGRATION_DATABASE_URL=postgres://postgres:CHANGE_ME@127.0.0.1:5432/mas_radar_dev
# Password for `pnpm db:app-role:password` (scripts/db/set-app-role-password.ts). Leave empty for masked TTY prompt, or set >=12 chars.
MAS_RADAR_APP_DB_PASSWORD=

# ── Native PostgreSQL 16 (ops; the only canonical database) ──────────
MAS_PG_RUNTIME=native
MAS_PG_BIN_DIR=C:\MAS\pgsql16\bin
MAS_BACKUP_TIMEOUT_MS=
MAS_ALERT_CHANNELS=

# ── Auth & proxy trust ───────────────────────────────────────────────
# SEED_ADMIN_PASSWORD is read only by scripts/db/seed-admin.ts; leave empty for masked TTY prompt, or set >=12 chars before seeding.
SEED_ADMIN_PASSWORD=
# Closed-circuit local mode ignores X-Forwarded-For / X-Real-IP unless MAS_TRUST_PROXY=1.
MAS_TRUST_PROXY=0
MAS_QA_BYPASS_AUTH=

# ── Telegram & Email reminders (optional; SERVER-ONLY) ───────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_INTERNAL_API_KEY=
MAS_APP_BASE_URL=http://127.0.0.1:3000
# EMAIL_API_URL must be https:// and non-private; optionally pin allowed domains in MAS_ALLOWED_EMAIL_HOSTS.
EMAIL_API_URL=
MAS_ALLOWED_EMAIL_HOSTS=
EMAIL_API_KEY=
EMAIL_TO=

# ── Outbound integration allowlist (optional; SERVER-ONLY) ───────────
# Comma-separated extra HTTPS hosts beyond api.parasut.com and www.tcmb.gov.tr.
MAS_ALLOWED_INTEGRATION_HOSTS=

# ── AI Q&A / report commentary (closed-circuit default = 1) ──────────
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5
AI_FORCE_DETERMINISTIC=1

# ── Build/version metadata (optional) ────────────────────────────────
APP_COMMIT_SHA=
APP_BUILD_TIME=
