# MAS Nakit Radar — environment template. Copy to .env.local and fill in.
# NEVER commit .env.local. Real secrets stay out of git (.gitignore blocks .env*).

# ── Database (required) ──────────────────────────────────────────────
# Points the app + scripts at the local PostgreSQL 16 instance (Docker).
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/mas_radar_dev

# Postgres container credentials (used by docker-compose). Change the password
# for a real private deployment; keep the DB bound to 127.0.0.1 only.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# ── Local access gate (recommended for private deploy) ───────────────
# When set, dashboard routes require this password (cookie session). Leave unset
# on a fully trusted single-machine setup. Server-only — never sent to the client.
APP_ACCESS_PASSWORD=

# ── Telegram reminders (optional; SERVER-ONLY) ───────────────────────
# If unset, reminder dispatch logs 'failed' honestly (no send). Never exposed to client.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── AI Q&A / report commentary (optional; SERVER-ONLY) ───────────────
# If OPENAI_API_KEY is unset, /ask falls back to deterministic facts-only answers.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5
AI_FORCE_DETERMINISTIC=0

# ── Build/version metadata (optional) ────────────────────────────────
# Shown on /version. Populate from git in CI/deploy if desired.
APP_COMMIT_SHA=
APP_BUILD_TIME=
